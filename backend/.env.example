# Backend
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL=sqlite:///./app.db

# Vector DB
CHROMA_PERSIST_DIR=./chroma_data

# LLM Providers (add your keys)
OPENAI_API_KEY=
NVIDIA_NIM_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434

# Embedding Model
EMBEDDING_MODEL=all-MiniLM-L6-v2

# File Upload
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=./uploads

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Local debugging only. Prints user questions and RAG context in backend logs.
DEBUG_LLM_PAYLOADS=false

# ── Phase 2: Billing ────────────────────────────────────────────────────────
# Keep false locally. Set true only when Stripe is connected.
BILLING_ENABLED=false

# ── Phase 3: Integrations (Zapier / CRM webhooks) ──────────────────────────
# Keep false locally. Set true when webhook_url is configured per site.
INTEGRATIONS_ENABLED=false

# ── Phase 1: Web Crawler ────────────────────────────────────────────────────
CRAWLER_MAX_PAGES=50
CRAWLER_MAX_DEPTH=3

# ── Phase 4: Language Detection ────────────────────────────────────────────
LANGUAGE_DETECTION_ENABLED=true
